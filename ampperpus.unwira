<style amp-custom>

    /* ── ROOT VARIABLES ── */
    :root {
      --blood:       #8B0000;
      --blood-dim:   #5C0000;
      --silver:      #C0C0C0;
      --silver-dim:  #808080;

      --dark:        #000000;
      --dark-card:   #0a0a0a;

      --border:      rgba(192, 192, 192, 0.35);

      --text:        #FFFFFF;
      --text-dim:    #A8A8A8;
    }


    /* ── RESET ── */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }


    body {
      font-family: 'Rajdhani', sans-serif;
      background: var(--dark);
      min-height: 100vh;
      overflow-x: hidden;
    }


    /* ── HERO BACKGROUND ── */
    .hero-bg {
      position: fixed;
      inset: 0;
      z-index: 0;
      background: var(--dark);
    }

    .hero-bg amp-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;

      /* Lebih gelap dengan nuansa merah */
      filter: brightness(0.15) grayscale(0.6) sepia(0.25);
    }


    /* ── GRID SCANLINES ── */
    .scanlines {
      position: fixed;
      inset: 0;
      z-index: 1;

      background-image:
        repeating-linear-gradient(
          0deg,
          transparent,
          transparent 3px,
          rgba(192, 192, 192, 0.025) 3px,
          rgba(192, 192, 192, 0.025) 4px
        );

      pointer-events: none;
    }


    /* ── OVERLAY / CENTER ── */
    .overlay {
      position: relative;
      z-index: 10;
      min-height: 100vh;

      display: flex;
      align-items: center;
      justify-content: center;

      padding: 20px 16px;
    }


    /* ── CARD ── */
    .card {
      width: 100%;
      max-width: 420px;

      background: var(--dark-card);

      border-radius: 16px;
      overflow: hidden;

      border: 1px solid var(--border);

      box-shadow:
        0 0 20px rgba(139, 0, 0, 0.25),
        0 0 40px rgba(192, 192, 192, 0.05);
    }


    /* ── TOPBAR ── */
    .topbar {
      height: 58px;

      display: flex;
      align-items: center;
      justify-content: center;

      background: #000000;

      border-bottom: 1px solid var(--border);

      position: relative;
    }

    .topbar img {
      height: 50px;

      position: relative;
      z-index: 1;

      filter:
        drop-shadow(0 0 4px #C0C0C0)
        drop-shadow(0 0 8px rgba(139, 0, 0, 0.7));
    }


    /* ── BANNER ── */
    .banner {
      position: relative;
      overflow: hidden;

      border-top: 5px double var(--blood);
      border-bottom: 5px double var(--blood);

      box-shadow:
        0 0 10px rgba(139, 0, 0, 0.5);
    }

    .banner img {
      width: 100%;
      display: block;
    }


    /* ── TITLEBAR ── */
    .titlebar {
      padding: 11px 16px;

      text-align: center;

      font-family: 'Orbitron', monospace;
      font-weight: 700;
      font-size: 11px;

      letter-spacing: 1.5px;

      color: var(--silver);

      text-transform: uppercase;

      background: #000000;

      border-bottom: 1px solid var(--border);

      text-shadow:
        0 0 6px rgba(192, 192, 192, 0.6),
        0 0 12px rgba(139, 0, 0, 0.5);
    }


    /* ── CONTENT ── */
    .content {
      padding: 16px;

      background:
        linear-gradient(
          0deg,
          #000000 0%,
          #180000 45%,
          #3B0000 100%
        );
    }


    /* ── BUTTONS ── */
    .btns {
      display: flex;
      gap: 7px;

      flex-direction: column;

      padding: 10px;
    }


    .btn {
      flex: 1;

      height: 46px;
      line-height: 44px;

      text-align: center;
      text-decoration: none;

      font-family: 'Orbitron', monospace;
      font-weight: 800;

      border-radius: 8px;

      font-size: 13px;
      letter-spacing: 2px;

      text-transform: uppercase;

      transition: all 0.2s ease;
    }


    /* ── DAFTAR BUTTON ── */
    .btn-daftar {
      background:
        linear-gradient(
          180deg,
          #A00000,
          #650000
        );

      color: #FFFFFF;

      border: 3px solid #C0C0C0;

      cursor: pointer;

      animation:
        bloodGlow 1.5s infinite ease-in-out;

      transition:
        transform 0.2s,
        box-shadow 0.2s;
    }


    /* ── HOVER ── */
    .btn-daftar:hover {
      transform: scale(1.08);

      box-shadow:
        0 0 15px rgba(139, 0, 0, 0.9),
        0 0 30px rgba(139, 0, 0, 0.7);
    }


    /* ── BLOOD GLOW ── */
    @keyframes bloodGlow {

      0% {
        box-shadow:
          0 0 5px rgba(139, 0, 0, 0.4),
          0 0 10px rgba(139, 0, 0, 0.3);

        transform: scale(1);
      }

      50% {
        box-shadow:
          0 0 15px rgba(139, 0, 0, 0.9),
          0 0 35px rgba(139, 0, 0, 0.7),
          0 0 55px rgba(192, 192, 192, 0.2);

        transform: scale(1.05);
      }

      100% {
        box-shadow:
          0 0 5px rgba(139, 0, 0, 0.4),
          0 0 10px rgba(139, 0, 0, 0.3);

        transform: scale(1);
      }
    }


    /* ── LOGIN BUTTON ── */
    .btn-login {
      background: #000000;

      border: 2px solid var(--silver);

      color: var(--silver);

      box-shadow:
        0 0 8px rgba(192, 192, 192, 0.15),
        inset 0 0 8px rgba(139, 0, 0, 0.15);
    }


    .btn-login:hover {
      background: #160000;

      color: #FFFFFF;

      border-color: #FFFFFF;

      box-shadow:
        0 0 12px rgba(192, 192, 192, 0.35),
        0 0 20px rgba(139, 0, 0, 0.4);
    }


    /* ── INFO ── */
    .info {
      background: #000000;

      border-radius: 10px;

      border: 1px solid var(--border);

      overflow: hidden;

      box-shadow:
        inset 0 0 15px rgba(139, 0, 0, 0.08);
    }


    .row {
      display: flex;

      padding: 10px 14px;

      border-bottom:
        1px solid rgba(192, 192, 192, 0.12);
    }


    .row:last-child {
      border-bottom: none;
    }


    .label {
      width: 45%;

      color: var(--silver-dim);

      font-weight: 600;

      font-size: 13px;

      letter-spacing: 0.5px;

      text-transform: uppercase;
    }


    .value {
      width: 55%;

      color: var(--text);

      font-size: 13px;

      font-weight: 600;
    }


    /* ── STATS BADGES ── */
    .stats-grid {
      display: grid;

      grid-template-columns: 1fr 1fr;

      gap: 8px;

      margin-bottom: 14px;
    }


    .stat-badge {
      background: #000000;

      border:
        1px solid rgba(192, 192, 192, 0.35);

      border-radius: 8px;

      padding: 8px 12px;

      display: flex;

      align-items: center;

      justify-content: space-between;

      box-shadow:
        inset 0 0 10px rgba(139, 0, 0, 0.08);
    }


    .stat-label {
      font-family: 'Orbitron', monospace;

      font-size: 9px;

      color: var(--text-dim);

      letter-spacing: 1px;

      text-transform: uppercase;
    }


    .stat-value {
      font-family: 'Orbitron', monospace;

      font-size: 13px;

      font-weight: 700;

      color: var(--silver);

      text-shadow:
        0 0 8px rgba(192, 192, 192, 0.5);
    }


    /* ── FOOTER ── */
    .footer {
      margin-top: 14px;

      text-align: center;

      font-size: 11px;

      color: var(--text-dim);

      letter-spacing: 1px;

      text-transform: uppercase;

      font-family: 'Orbitron', monospace;

      padding-top: 10px;

      border-top:
        1px solid rgba(192, 192, 192, 0.2);
    }


    .footer span {
      color: var(--silver);

      text-shadow:
        0 0 7px rgba(192, 192, 192, 0.5);
    }


    /* ── COPYRIGHT ── */
    .copyright a {
      color: var(--silver);

      text-decoration: none;

      text-shadow:
        0 0 6px rgba(139, 0, 0, 0.7);
    }


    .copyright a:hover {
      color: #FFFFFF;

      text-shadow:
        0 0 8px rgba(192, 192, 192, 0.8),
        0 0 15px rgba(139, 0, 0, 0.8);
    }

</style>
</head>

