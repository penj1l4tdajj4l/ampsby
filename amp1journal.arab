}

#bottom-navbar ul li a {

  display: flex;

  flex-direction: column;

  align-items: center;
  justify-content: center;

  gap: 3px;

  height: var(--nav-h);

  text-decoration: none;

  color: var(--c-white);

  font-family:
    'Orbitron',
    sans-serif;

  font-size: 10px;

  font-weight: 700;

  letter-spacing: 1px;

  transition:
