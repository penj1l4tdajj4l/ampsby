<style amp-custom>

:root {
  --maxw: 480px;
  --nav-h: 62px;
  --nav-space: 75px;

  /* ========================
     DARK BLOOD RED + SILVER
  ======================== */
  --c-bg: #080002;

  --c-red: #8f0018;
  --c-dark-red: #3d0009;
  --c-blood: #65000f;

  --c-white: #e2e2e5;
  --c-silver: #bfc0c4;
  --c-chrome: #d9d9dd;

  --c-glass: rgba(15, 3, 6, 0.90);

  --c-border: rgba(190, 190, 195, 0.45);

  --r-card: 16px;
  --r-btn: 10px;

  --shadow-hd:
    0 10px 30px rgba(0, 0, 0, 0.9),
    0 0 18px rgba(105, 0, 15, 0.45);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

::-webkit-scrollbar {
  display: none;
}

html {
  max-width: var(--maxw);
  margin: 0 auto;

  background-color: var(--c-bg);

  background-image:
    url('https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEiwM7m3ovXnbS-8lOEe03qw8LUpXItYc7Sa8xw8T0W0NZgL8Srve0K3Quf2f86ZtDce4ZS48yNiM4Ch4U1kgzkBrZgf5oGtLxwXdd6Fxwa5A-akcC7E_1CJ3L3cuMZhRyiLlclgAycN8lflSEDdFWZT3_B9iBORqJRwTsbjZY5apqEnfvKCpZHdu21X8O8X/s1920/bground.jpg');

  background-size: cover;
  background-repeat: no-repeat;
  background-position: center;
  background-attachment: fixed;

  font-family: 'Rajdhani', sans-serif;
  position: relative;
}

html::before {
  content: "";

  position: fixed;
  inset: 0;

  background:
    radial-gradient(
      circle at 50% 30%,
      rgba(55, 0, 8, 0.55) 0%,
      rgba(12, 0, 3, 0.86) 55%,
      rgba(3, 0, 1, 0.97) 100%
    );

  z-index: -1;
}

body {
  color: var(--c-white);
  overflow-x: hidden;
}

main {
  padding-bottom: var(--nav-space);
}

.macallan {
  padding: 12px 12px 0;
}


/* ========================
   FRAME UTAMA
   BLOOD RED + CHROME
======================== */
.combo-block {
  position: relative;

  margin-bottom: 22px;
  border-radius: var(--r-card);
  padding: 2px;

  background:
    linear-gradient(
      135deg,
      #50000c,
      #b5b5ba,
      #750012,
      #e5e5e8,
      #3d0008,
      #9c0019
    );

  background-size: 400% 400%;

  animation: borderMove 5s ease infinite;

  box-shadow:
    0 12px 35px rgba(0,0,0,0.95),
    0 0 18px rgba(90,0,12,0.65),
    0 0 35px rgba(45,0,6,0.5);
}

@keyframes borderMove {

  0% {
    background-position: 0% 50%;
  }

  50% {
    background-position: 100% 50%;
  }

  100% {
    background-position: 0% 50%;
  }

}

.combo-inner {
  background: var(--c-glass);

  backdrop-filter: blur(8px);

  border-radius:
    calc(var(--r-card) - 2px);

  overflow: hidden;
}


/* ========================
   HEADER
======================== */
.combo-header {
  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 10px 14px;

  background:
    linear-gradient(
      180deg,
      rgba(105,0,15,0.38) 0%,
      rgba(12,2,4,0.92) 100%
    );

  border-bottom:
    1px solid rgba(190,190,195,0.35);

  box-shadow:
    inset 0 -1px 0 rgba(255,255,255,0.05);
}

.button-container {
  display: flex;
  gap: 8px;
}


/* ========================
   MAIN BUTTON
======================== */
.btn {
  position: relative;

  display: inline-block;

  background:
    linear-gradient(
      135deg,
      #450007 0%,
      #850013 38%,
      #b0b0b5 100%
    );

  color: #ffffff;

  text-decoration: none;

  font-family: 'Orbitron', sans-serif;
  font-weight: 900;
  font-size: 11px;

  text-transform: uppercase;
  letter-spacing: 1px;

  padding: 8px 16px;

  border-radius: var(--r-btn);

  border:
    1px solid rgba(210,210,215,0.65);

  box-shadow:
    0 4px 15px rgba(75,0,10,0.65),
    inset 0 2px 3px rgba(255,255,255,0.35);

  transition: all 0.2s ease;

  overflow: hidden;
}


/* Button metallic shine */
.btn::before {
  content: '';

  position: absolute;

  top: -50%;
  left: -50%;

  width: 200%;
  height: 200%;

  background:
    linear-gradient(
      45deg,
      transparent,
      rgba(255,255,255,0.65),
      transparent
    );

  transform:
    rotate(45deg)
    translateY(-100%);

  animation: shine 3s infinite;
}

@keyframes shine {

  0% {
    transform:
      rotate(45deg)
      translateY(-100%);
  }

  20%, 100% {
    transform:
      rotate(45deg)
      translateY(100%);
  }

}


/* ========================
   SILVER BUTTON
======================== */
.btn-white {
  background:
    linear-gradient(
      135deg,
      #eeeeef 0%,
      #a8a8ad 45%,
      #f4f4f5 70%,
      #88888d 100%
    );

  color: #4a0009;

  box-shadow:
    0 4px 15px rgba(180,180,185,0.3),
    inset 0 2px 3px #ffffff;

  border:
    1px solid #dedee2;
}


/* ========================
   HERO IMAGE
======================== */
.combo-hero {
  position: relative;

  width: 100%;

  display: block;

  background: #000;

  overflow: hidden;
}

.combo-hero amp-carousel {
  width: 100%;
}

.combo-hero amp-img img {
  object-fit: cover;
  object-position: center;
}


/* ========================
   ACTION BLOCKS
======================== */
.abonus {
  display: grid;
  gap: 12px;
}

.block {
  position: relative;

  display: flex;

  align-items: center;
  justify-content: center;

  padding: 15px 20px;

  border-radius: var(--r-card);

  text-decoration: none;

  font-family: 'Orbitron', sans-serif;
  font-weight: 900;
  font-size: 14px;

  letter-spacing: 1.5px;

  color: #eeeeef;

  background:
    linear-gradient(
      135deg,
      rgba(60,0,12,0.94) 0%,
      rgba(22,3,6,0.97) 55%,
      rgba(55,55,60,0.45) 100%
    );

  border:
    1px solid rgba(170,170,175,0.42);

  box-shadow: var(--shadow-hd);

  text-shadow:
    0 2px 4px rgba(0,0,0,0.95),
    0 0 8px rgba(120,0,18,0.7);

  transition:
    all 0.25s cubic-bezier(
      0.175,
      0.885,
      0.32,
      1.275
    );

  overflow: hidden;
}


/* Running chrome border */
.block::before {
  content: '';

  position: absolute;
  inset: -2px;

  background:
    linear-gradient(
      90deg,
      #4b000a,
      #bcbcc1,
      #65000f,
      #e2e2e5,
      #4b000a
    );

  background-size: 300%;

  z-index: -1;

  border-radius:
    calc(var(--r-card) + 2px);

  opacity: 0.42;

  animation:
    steam 5s linear infinite;
}


/* Light sweep */
.block::after {
  content: '';

  position: absolute;

  top: 0;
  left: -100%;

  width: 60%;
  height: 100%;

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(220,220,225,0.32),
      transparent
    );

  transform: skewX(-25deg);

  animation:
    lightSweep 4s ease-in-out infinite;
}

@keyframes lightSweep {

  0%, 50% {
    left: -100%;
  }

  70%, 100% {
    left: 200%;
  }

}


/* ========================
   BLOCK HOVER
======================== */
.block:hover,
.block:active {

  transform:
    translateY(-3px)
    scale(1.02);

  border-color:
    rgba(220,220,225,0.9);

  background:
    linear-gradient(
      135deg,
      rgba(125,0,18,0.97) 0%,
      rgba(55,3,10,0.97) 55%,
      rgba(150,150,155,0.5) 100%
    );

  box-shadow:
    0 15px 30px rgba(0,0,0,1),
    0 0 20px rgba(120,0,18,0.85),
    0 0 35px rgba(80,0,10,0.45);
}


/* ========================
   FOOTER
======================== */
.footer {
  text-align: center;

  margin: 25px 0 15px;

  color:
    rgba(215,215,220,0.8);

  font-size: 11px;

  font-family:
    'Rajdhani',
    sans-serif;

  font-weight: 700;

  letter-spacing: 1px;

  text-shadow:
    0 1px 2px #000,
    0 0 6px rgba(170,170,175,0.2);
}


/* ========================
   BOTTOM NAVBAR
======================== */
#bottom-navbar {

  position: fixed;

  bottom: 0;
  left: 0;
  right: 0;

  max-width: var(--maxw);

  margin: 0 auto;

  z-index: 999;

  background:
    linear-gradient(
      180deg,
      rgba(28,3,7,0.96),
      rgba(8,2,4,0.98)
    );

  backdrop-filter: blur(15px);

  border-top:
    1px solid rgba(175,175,180,0.4);

  box-shadow:
