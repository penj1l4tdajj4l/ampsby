}


/* Divider */
#bottom-navbar ul li+li a {
  border-left:
    1px solid rgba(190,190,195,0.12);
}


/* ========================
   NAV ICON
======================== */
#bottom-navbar span.material-icons {

  font-size: 22px;

  color:
    #a9001b;

  filter:
    drop-shadow(
      0 0 6px
      rgba(130,0,18,0.9)
    );

  transition:
    transform 0.2s ease,
    color 0.2s ease;
}


/* Icon hover */
#bottom-navbar ul li a:hover
span.material-icons {

  transform:
    translateY(-3px)
    scale(1.2);

  color:
    #dedee2;

  filter:
    drop-shadow(
      0 0 8px
      rgba(220,220,225,0.8)
    );
}


/* Nav hover */
#bottom-navbar ul li a:hover {

  background:
    linear-gradient(
      180deg,
      rgba(100,0,15,0.3) 0%,
      transparent 100%
    );

  color:
    #ffffff;
}


/* ========================
   BORDER ANIMATION
======================== */
@keyframes steam {

  0% {
    background-position: 0% 50%;
  }

  50% {
    background-position: 100% 50%;
  }

  100% {
    background-position: 0% 50%;
  }

}

</style>
