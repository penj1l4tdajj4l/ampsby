<style amp-custom>
* {
    box-sizing: border-box;
}

body {
    font-family: monospace;
    position: relative;
    margin: 0;
    min-height: 100vh;
    color: #fff;
    background-color: #080808;
    background-image: url('https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEiwM7m3ovXnbS-8lOEe03qw8LUpXItYc7Sa8xw8T0W0NZgL8Srve0K3Quf2f86ZtDce4ZS48yNiM4Ch4U1kgzkBrZgf5oGtLxwXdd6Fxwa5A-akcC7E_1CJ3L3cuMZhRyiLlclgAycN8lflSEDdFWZT3_B9iBORqJRwTsbjZY5apqEnfvKCpZHdu21X8O8X/s1920/bground.jpg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: fixed;
}

.container {
    max-width: 400px;
    height: 100vh;
    margin: 0 auto;
    padding: 15px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;

    background:
        linear-gradient(
            145deg,
            rgba(20,5,7,.78),
            rgba(5,5,6,.72)
        );

    border-radius: 12px;
    border: 1px solid rgba(185,190,195,.22);

    box-shadow:
        0 0 25px rgba(80,0,8,.35),
        inset 0 1px 0 rgba(255,255,255,.08);
}

.welcome {
    max-width: 350px;
    margin: 0 auto;
}


/* =====================================================
   WELCOME TYPING — SILVER
   ===================================================== */

.welcome h1 {
    font-size:12px;
    color:#d9dbde;
    overflow:hidden;
    border-right:.15em solid #bfc2c5;
    white-space:nowrap;
    letter-spacing:.09em;

    text-shadow:
        0 0 8px rgba(255,255,255,.18);

    animation:
        typing 3.5s steps(40,end),
        blink-caret .75s step-end infinite;
}

@keyframes typing {
    from {width:0}
    to {width:100%}
}

@keyframes blink-caret {
    from,to {
        border-color:transparent;
    }

    50% {
        border-color:#d5d7da;
    }
}


/* =====================================================
   BANNER — BLOOD RED + SILVER LIGHT
   ===================================================== */

.banner-wrapper {
    position:relative;
    width:100%;
    border-radius:12px;
    padding:3px;
    overflow:hidden;

    display:flex;
    justify-content:center;
    align-items:center;

    background:#120204;
}

.banner-wrapper::before {
    content:'';
    position:absolute;
    width:160%;
    height:160%;

    background:
        conic-gradient(
            #4d0409,
            #9e1b23,
            #f0f1f2,
            #777b80,
            transparent 55%,
            #6d080f,
            #b3212a,
            #4d0409
        );

    animation:spinLight 4s linear infinite;
    z-index:1;

    filter:
        drop-shadow(0 0 8px rgba(160,15,25,.55));
}

@keyframes spinLight {
    100% {
        transform:rotate(360deg);
    }
}

.banner {
    border-radius:10px;
    position:relative;
    z-index:2;
    background:#170407;
    display:block;
}


/* =====================================================
   LOGIN & DAFTAR — PREMIUM BASE
   ===================================================== */

.btn-login,
.btn-daftar {
    padding:11px 10px;

    color:#fff;

    font-size:20px;
    font-weight:bold;

    text-decoration:none;
    text-align:center;

    margin-top:10px;

    border-radius:12px;

    position:relative;
    z-index:2;

    overflow:hidden;

    border:2px solid #aeb1b5;

    text-shadow:
        0 2px 3px rgba(0,0,0,.85);

    transition:
        transform .3s ease,
        box-shadow .3s ease,
        border-color .3s ease,
        filter .3s ease;
}


/* =====================================================
   GLOSSY SHINE
   ===================================================== */

.btn-login::before,
.btn-daftar::before {
    content:"";

    position:absolute;
    top:-60%;
    left:-75%;

    width:38%;
    height:220%;

    pointer-events:none;

    background:
        linear-gradient(
            90deg,
            transparent,
            rgba(255,255,255,.08),
            rgba(255,255,255,.8),
            rgba(255,255,255,.08),
            transparent
        );

    transform:rotate(22deg);

    animation:
        buttonShine 4.5s ease-in-out infinite;
}

@keyframes buttonShine {

    0%,25% {
        left:-75%;
        opacity:0;
    }

    35% {
        opacity:.9;
    }

    55%,100% {
        left:135%;
        opacity:0;
    }
}


/* =====================================================
   METALLIC TOP HIGHLIGHT
   ===================================================== */

.btn-login::after,
.btn-daftar::after {
    content:"";

    position:absolute;

    top:1px;
    left:7%;
    right:7%;

    height:35%;

    pointer-events:none;

    background:
        linear-gradient(
            180deg,
            rgba(255,255,255,.42),
            rgba(255,255,255,.10),
            transparent
        );

    border-radius:10px 10px 50% 50%;
}


/* =====================================================
   LOGIN — DARK BLOOD RED
   ===================================================== */

.btn-login {
    background:
        radial-gradient(
            circle at 50% 0,
            rgba(255,100,110,.45),
            transparent 45%
        ),
        linear-gradient(
            180deg,
            #a51d26 0%,
            #720b12 30%,
            #430308 58%,
            #65070e 78%,
            #971820 100%
        );

    border-color:#bfc2c5;

    box-shadow:
        0 4px 0 #270104,
        0 7px 18px rgba(80,0,8,.72),
        0 0 14px rgba(140,10,20,.28),
        inset 0 1px 0 rgba(255,255,255,.5),
        inset 0 -4px 8px rgba(0,0,0,.4);
}


/* =====================================================
   DAFTAR — BLOOD RED + SILVER METALLIC
   ===================================================== */

.btn-daftar {
    background:
        radial-gradient(
            circle at 50% 0,
            rgba(255,255,255,.5),
            transparent 43%
        ),
        linear-gradient(
            180deg,
            #e4e6e8 0%,
            #aeb2b6 16%,
            #6e7277 34%,
            #3f080d 55%,
            #65080e 74%,
            #9b1820 100%
        );

    border-color:#d7d9dc;

    box-shadow:
        0 4px 0 #280104,
        0 7px 18px rgba(70,0,6,.72),
        0 0 15px rgba(190,193,197,.20),
        inset 0 1px 0 rgba(255,255,255,.8),
        inset 0 -4px 8px rgba(0,0,0,.42);
}


/* =====================================================
   HOVER — PREMIUM GLOW
   ===================================================== */

.btn-login:hover,
.btn-daftar:hover {
    transform:
        translateY(-3px)
        scale(1.015);

    border-color:#ffffff;

    filter:brightness(1.12);

    box-shadow:
        0 6px 0 #210104,
        0 11px 25px rgba(110,0,10,.75),
        0 0 25px rgba(185,25,35,.35),
        inset 0 1px 0 rgba(255,255,255,.9),
        inset 0 -4px 8px rgba(0,0,0,.45);
}


/* =====================================================
   ACTIVE / CLICK
   ===================================================== */

.btn-login:active,
.btn-daftar:active {
    transform:
        translateY(1px)
        scale(.985);

    box-shadow:
        0 2px 0 #210104,
        0 4px 10px rgba(50,0,5,.65),
        inset 0 3px 7px rgba(0,0,0,.5);
}


/* =====================================================
   COPYRIGHT
   ===================================================== */

.copyright {
    text-align:center;

    color:
        rgba(205,208,211,.78);

    text-shadow:
        0 1px 3px rgba(0,0,0,.8);
}


/* =====================================================
   BACKGROUND ELEMENT
   ===================================================== */

.nagaterbang {
    position:fixed;
    z-index:1;
    left:0;
    right:0;
    top:0;
    bottom:0;
    margin:auto;
}


/* =====================================================
   REDUCED MOTION
   ===================================================== */

@media(prefers-reduced-motion:reduce){

    .banner-wrapper::before,
    .btn-login::before,
    .btn-daftar::before,
    .welcome h1{
        animation:none;
    }

    .btn-login,
    .btn-daftar{
        transition:none;
    }
}
</style>

